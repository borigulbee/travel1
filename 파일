  <div id="toast" class="toast"></div>

  <script>
    const STORAGE_KEY = 'iberia_travel_planner_2027_v1';
    const GH_SYNC_KEY = 'iberia_gh_sync_2027_v1';
    const START_DATE = '2027-01-24';
    const TOTAL_DAYS = 19;
    const WEEKDAYS = ['일', '월', '화', '수', '목', '금', '토'];

    let state = {
      updatedAt: 0,
      days: [],
      bookings: {
        flights: [],
        stays: [],
        transports: []
      }
    };

    let selectedDayIndex = 0;
    let ghConfig = { token: '', gistId: '' };
    let pollTimer = null;

    // Initialize 19 days (2027-01-24 ~ 2027-02-11)
    function createDefaultDays() {
      const days = [];
      const base = new Date(2027, 0, 24);
      for (let i = 0; i < TOTAL_DAYS; i++) {
        const d = new Date(base);
        d.setDate(base.getDate() + i);
        const yyyy = d.getFullYear();
        const mm = String(d.getMonth() + 1).padStart(2, '0');
        const dd = String(d.getDate()).padStart(2, '0');
        const w = WEEKDAYS[d.getDay()];
        let defaultCity = '일정 미정';
        let defaultCountry = 'PT';
        if (i === 0) { defaultCity = '인천 → 출발'; defaultCountry = 'TR'; }
        if (i === TOTAL_DAYS - 1) { defaultCity = '귀국 도착'; defaultCountry = 'TR'; }
        days.push({
          dayNum: i + 1,
          dateStr: `${yyyy}-${mm}-${dd}`,
          shortDate: `${d.getMonth() + 1}/${d.getDate()}(${w})`,
          fullDate: `${yyyy}년 ${d.getMonth() + 1}월 ${d.getDate()}일 (${w}요일)`,
          country: defaultCountry,
          city: defaultCity,
          note: '',
          items: []
        });
      }
      return days;
    }

    function showToast(msg) {
      const el = document.getElementById('toast');
      el.textContent = msg;
      el.classList.add('show');
      clearTimeout(el._t);
      el._t = setTimeout(() => el.classList.remove('show'), 2600);
    }

    function updateDday() {
      const today = new Date();
      today.setHours(0, 0, 0, 0);
      const start = new Date(2027, 0, 24);
      const diff = Math.round((start - today) / (1000 * 60 * 60 * 24));
      const badge = document.getElementById('ddayBadge');
      if (diff > 0) badge.textContent = `출발까지 D-${diff}`;
      else if (diff === 0) badge.textContent = `🎉 오늘 출발!`;
      else if (diff > -TOTAL_DAYS) badge.textContent = `여행 ${Math.abs(diff) + 1}일차`;
      else badge.textContent = `여행 완료`;
    }

    // UTF-8 safe Base64 helpers for instant URL sharing
    function encodeSharePayload(obj) {
      const json = JSON.stringify(obj);
      const bytes = new TextEncoder().encode(json);
      let bin = '';
      bytes.forEach(b => bin += String.fromCharCode(b));
      return btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
    }

    function decodeSharePayload(str) {
      let b64 = str.replace(/-/g, '+').replace(/_/g, '/');
      while (b64.length % 4) b64 += '=';
      const bin = atob(b64);
      const bytes = new Uint8Array(bin.length);
      for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
      return JSON.parse(new TextDecoder().decode(bytes));
    }

    function copyInstantShareLink() {
      try {
        const encoded = encodeSharePayload(state);
        const url = `${window.location.origin}${window.location.pathname}#share=${encoded}`;
        navigator.clipboard.writeText(url).then(() => {
          showToast('🔗 현재 일정이 담긴 공유 링크가 복사되었습니다!');
        }).catch(() => {
          prompt('아래 링크를 복사해서 일행에게 공유하세요:', url);
        });
      } catch (e) {
        showToast('링크 생성 중 오류가 발생했습니다. 백업 파일을 이용해주세요.');
      }
    }

    // Load & Save State
    async function initApp() {
      updateDday();
      const saved = localStorage.getItem(STORAGE_KEY);
      if (saved) {
        try {
          state = JSON.parse(saved);
        } catch (e) {}
      }
      if (!state.days || state.days.length !== TOTAL_DAYS) {
        state.days = createDefaultDays();
      }
      if (!state.bookings) {
        state.bookings = { flights: [], stays: [], transports: [] };
      }

      const savedGh = localStorage.getItem(GH_SYNC_KEY);
      if (savedGh) {
        try { ghConfig = JSON.parse(savedGh); } catch (e) {}
      }

      // Check URL hash (#gh=gistId:token OR #share=...)
      const hash = window.location.hash || '';
      if (hash.startsWith('#gh=')) {
        const parts = hash.slice(4).split(':');
        if (parts.length === 2 && parts[0] && parts[1]) {
          ghConfig = { gistId: parts[0], token: parts[1] };
          localStorage.setItem(GH_SYNC_KEY, JSON.stringify(ghConfig));
        }
      } else if (hash.startsWith('#share=')) {
        try {
          const sharedData = decodeSharePayload(hash.slice(7));
          if (sharedData && Array.isArray(sharedData.days)) {
            const hasLocalItems = state.days.some(d => d.items && d.items.length > 0);
            if (!hasLocalItems || confirm('공유받은 여행 일정을 불러올까요? (현재 기기의 일정이 공유받은 일정으로 덮어씌워집니다)')) {
              state = sharedData;
              localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
              showToast('✅ 공유받은 일정을 불러왔습니다!');
            }
            history.replaceState(null, '', window.location.pathname);
          }
        } catch (e) {
          console.error(e);
        }
      }

      renderAll();

      if (ghConfig.token && ghConfig.gistId) {
        updateSyncBadge('live', '☁️ 실시간 동기화 중');
        await pullFromGh(true);
        startPolling();
      }
    }

    function saveState() {
      state.updatedAt = Date.now();
      localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
      renderAll();
      if (ghConfig.token && ghConfig.gistId) {
        pushToGh();
      }
    }

    // GitHub Gist Sync Logic
    function updateSyncBadge(mode, text) {
      const badge = document.getElementById('syncBadge');
      badge.textContent = text;
      badge.className = 'status-pill' + (mode === 'live' ? ' live' : '');
    }

    function openSyncModal() {
      document.getElementById('ghTokenInput').value = ghConfig.token || '';
      document.getElementById('ghGistIdInput').value = ghConfig.gistId || '';
      updateLiveShareBox();
      document.getElementById('syncModal').classList.add('open');
    }

    function updateLiveShareBox() {
      const box = document.getElementById('liveShareUrlBox');
      if (ghConfig.token && ghConfig.gistId) {
        const shareUrl = `${window.location.origin}${window.location.pathname}#gh=${ghConfig.gistId}:${ghConfig.token}`;
        document.getElementById('liveShareUrlInput').value = shareUrl;
        box.classList.remove('hidden');
      } else {
        box.classList.add('hidden');
      }
    }

    function copyLiveShareUrl() {
      const val = document.getElementById('liveShareUrlInput').value;
      navigator.clipboard.writeText(val).then(() => {
        showToast('🔗 실시간 공유 링크가 복사되었습니다!');
      });
    }

    async function connectGhSync() {
      const token = document.getElementById('ghTokenInput').value.trim();
      let gistId = document.getElementById('ghGistIdInput').value.trim();
      if (!token) {
        alert('GitHub Personal Access Token을 입력해주세요.');
        return;
      }
      updateSyncBadge('', '⏳ 연결 중...');
      try {
        if (!gistId) {
          // Create new private gist
          const res = await fetch('https://api.github.com/gists', {
            method: 'POST',
            headers: {
              'Authorization': `token ${token}`,
              'Accept': 'application/vnd.github.v3+json',
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({
              description: 'Portugal & Spain Travel Planner 2027',
              public: false,
              files: {
                'iberia-trip-2027.json': {
                  content: JSON.stringify(state, null, 2)
                }
              }
            })
          });
          if (!res.ok) throw new Error('토큰 인증에 실패했습니다. gist 권한을 확인해주세요.');
          const data = await res.json();
          gistId = data.id;
          document.getElementById('ghGistIdInput').value = gistId;
        } else {
          // Fetch existing gist
          ghConfig = { token, gistId };
          await pullFromGh(false);
        }
        ghConfig = { token, gistId };
        localStorage.setItem(GH_SYNC_KEY, JSON.stringify(ghConfig));
        history.replaceState(null, '', `#gh=${gistId}:${token}`);
        updateLiveShareBox();
        updateSyncBadge('live', '☁️ 실시간 동기화 중');
        startPolling();
        showToast('✅ GitHub 실시간 공유방이 연결되었습니다!');
      } catch (err) {
        updateSyncBadge('', '⚠️ 연결 실패');
        alert(err.message);
      }
    }

    async function pushToGh() {
      if (!ghConfig.token || !ghConfig.gistId) return;
      try {
        updateSyncBadge('live', '☁️ 저장 중...');
        const res = await fetch(`https://api.github.com/gists/${ghConfig.gistId}`, {
          method: 'PATCH',
          headers: {
            'Authorization': `token ${ghConfig.token}`,
            'Accept': 'application/vnd.github.v3+json',
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            files: {
              'iberia-trip-2027.json': {
                content: JSON.stringify(state, null, 2)
              }
            }
          })
        });
        if (res.ok) {
          updateSyncBadge('live', '☁️ 실시간 동기화됨');
        }
      } catch (e) {
        updateSyncBadge('', '📴 오프라인 (연결 시 동기화)');
      }
    }

    async function pullFromGh(silent = true) {
      if (!ghConfig.token || !ghConfig.gistId) return;
      try {
        const res = await fetch(`https://api.github.com/gists/${ghConfig.gistId}?t=${Date.now()}`, {
          headers: {
            'Authorization': `token ${ghConfig.token}`,
            'Accept': 'application/vnd.github.v3+json'
          }
        });
        if (!res.ok) throw new Error('동기화 불러오기 실패');
        const data = await res.json();
        const file = data.files && data.files['iberia-trip-2027.json'];
        if (file && file.content) {
          const remote = JSON.parse(file.content);
          if (remote && Array.isArray(remote.days)) {
            if (!silent || (remote.updatedAt && remote.updatedAt > (state.updatedAt || 0))) {
              state = remote;
              localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
              renderAll();
              if (!silent) showToast('🔄 최신 일정을 불러왔습니다.');
            }
          }
        }
        updateSyncBadge('live', '☁️ 실시간 동기화됨');
      } catch (e) {
        if (!silent) alert('데이터를 불러오지 못했습니다. 인터넷 연결과 토큰을 확인해주세요.');
        updateSyncBadge('', '📴 오프라인 대기');
      }
    }

    function manualPullGh() {
      pullFromGh(false);
    }

    function disconnectGhSync() {
      ghConfig = { token: '', gistId: '' };
      localStorage.removeItem(GH_SYNC_KEY);
      clearInterval(pollTimer);
      history.replaceState(null, '', window.location.pathname);
      updateSyncBadge('', '💾 기기 자동저장');
      closeModal('syncModal');
      showToast('실시간 동기화가 해제되었습니다.');
    }

    function startPolling() {
      clearInterval(pollTimer);
      pollTimer = setInterval(() => {
        if (document.visibilityState === 'visible') {
          pullFromGh(true);
        }
      }, 15000);
    }

    // Tabs
    function switchTab(tabName) {
      document.querySelectorAll('.nav-tab').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.tab === tabName);
      });
      ['timeline', 'bookings', 'overview'].forEach(t => {
        document.getElementById(`tab-${t}`).classList.toggle('hidden', t !== tabName);
      });
      renderAll();
    }

    // Rendering
    function renderAll() {
      renderDayStrip();
      renderSelectedDay();
      renderBookings();
      renderOverview();
    }

    function getCountryInfo(code) {
      if (code === 'PT') return { flag: '🇵🇹', label: '🇵🇹 포르투갈', cls: 'country-PT' };
      if (code === 'ES') return { flag: '🇪🇸', label: '🇪🇸 스페인', cls: 'country-ES' };
      return { flag: '✈️', label: '✈️ 이동/출국·귀국', cls: 'country-TR' };
    }

    function getCategoryInfo(cat) {
      const map = {
        spot: { label: '🏛️ 관광', cls: 'cat-spot' },
        food: { label: '🍽️ 맛집/카페', cls: 'cat-food' },
        move: { label: '🚆 이동', cls: 'cat-move' },
        stay: { label: '🏨 숙소', cls: 'cat-stay' },
        shop: { label: '🛍️ 쇼핑/기타', cls: 'cat-shop' }
      };
      return map[cat] || map.spot;
    }

    function renderDayStrip() {
      const strip = document.getElementById('dayStrip');
      strip.innerHTML = state.days.map((d, idx) => {
        const c = getCountryInfo(d.country);
        const count = d.items ? d.items.length : 0;
        return `
          <button class="day-chip ${idx === selectedDayIndex ? 'active' : ''}" onclick="selectDay(${idx})">
            <div class="day-chip-top">
              <span>Day ${d.dayNum}</span>
              <span>${c.flag}${count > 0 ? ` · ${count}` : ''}</span>
            </div>
            <div class="day-chip-date">${d.shortDate}</div>
            <div class="day-chip-city">${escapeHtml(d.city || '일정 미정')}</div>
          </button>
        `;
      }).join('');
    }

    function selectDay(idx) {
      selectedDayIndex = idx;
      renderDayStrip();
      renderSelectedDay();
    }

    function renderSelectedDay() {
      const day = state.days[selectedDayIndex];
      const c = getCountryInfo(day.country);
      document.getElementById('currentDayLabel').textContent = `Day ${day.dayNum}`;
      const badge = document.getElementById('currentCountryBadge');
      badge.textContent = c.label;
      badge.className = `country-badge ${c.cls}`;
      document.getElementById('currentDateFull').textContent = day.fullDate;
      document.getElementById('dayCountrySelect').value = day.country || 'PT';
      document.getElementById('dayCityInput').value = day.city || '';
      document.getElementById('dayNoteInput').value = day.note || '';

      const listEl = document.getElementById('timelineList');
      const items = (day.items || []).slice().sort((a, b) => (a.time || '').localeCompare(b.time || ''));

      if (items.length === 0) {
        listEl.innerHTML = `
          <div class="empty-state">
            <p>아직 등록된 세부 일정이 없습니다.<br/>방문할 명소나 맛집, 이동 일정을 추가해 보세요.</p>
            <button class="btn-primary" onclick="openItemModal()">+ 첫 일정 추가하기</button>
          </div>
        `;
        return;
      }

      listEl.innerHTML = items.map((item, i) => {
        const cat = getCategoryInfo(item.category);
        const query = encodeURIComponent(item.address ? `${item.place} ${item.address}` : `${item.place} ${day.city !== '일정 미정' ? day.city : ''}`);
        const mapUrl = `https://www.google.com/maps/search/?api=1&query=${query}`;

        let routeBtn = '';
        if (i > 0) {
          const prev = items[i - 1];
          const prevQuery = encodeURIComponent(prev.address ? `${prev.place} ${prev.address}` : `${prev.place} ${day.city !== '일정 미정' ? day.city : ''}`);
          const dirUrl = `https://www.google.com/maps/dir/?api=1&origin=${prevQuery}&destination=${query}`;
          routeBtn = `<a class="btn-route" href="${dirUrl}" target="_blank" rel="noopener">🧭 이전 장소에서 길찾기</a>`;
        }

        return `
          <div class="timeline-item ${cat.cls}">
            <div class="item-top">
              <div>
                <div class="item-time-row">
                  <span class="time-badge">${escapeHtml(item.time || '시간 미정')}</span>
                  <span class="cat-tag">${cat.label}</span>
                  ${item.duration ? `<span class="duration-text">⏱ ${escapeHtml(item.duration)}</span>` : ''}
                </div>
                <div class="item-title">${escapeHtml(item.place)}</div>
                ${item.address ? `<div class="item-address">📌 ${escapeHtml(item.address)}</div>` : ''}
              </div>
            </div>
            ${item.memo ? `<div class="item-memo">${escapeHtml(item.memo)}</div>` : ''}
            <div class="item-actions">
              <div class="map-btn-group">
                <a class="btn-map" href="${mapUrl}" target="_blank" rel="noopener">📍 구글 맵 위치 열기</a>
                ${routeBtn}
              </div>
              <div class="edit-btn-group">
                <button class="btn-outline" onclick="openItemModal('${item.id}')">✏️ 수정</button>
                <button class="btn-danger" onclick="deleteTimelineItem('${item.id}')">🗑️ 삭제</button>
              </div>
            </div>
          </div>
        `;
      }).join('');
    }

    function updateDayMeta() {
      const day = state.days[selectedDayIndex];
      day.country = document.getElementById('dayCountrySelect').value;
      day.city = document.getElementById('dayCityInput').value.trim() || '일정 미정';
      day.note = document.getElementById('dayNoteInput').value.trim();
      saveState();
    }

    function setCityPreset(country, city) {
      const day = state.days[selectedDayIndex];
      day.country = country;
      day.city = city;
      saveState();
      showToast(`${city} 설정 완료`);
    }

    // Timeline Modal CRUD
    function openItemModal(itemId = null) {
      const day = state.days[selectedDayIndex];
      document.getElementById('editItemId').value = itemId || '';
      if (itemId) {
        const item = day.items.find(x => x.id === itemId);
        document.getElementById('itemModalTitle').textContent = '일정 수정';
        document.getElementById('itemTime').value = item.time || '10:00';
        document.getElementById('itemDuration').value = item.duration || '';
        document.getElementById('itemCategory').value = item.category || 'spot';
        document.getElementById('itemPlace').value = item.place || '';
        document.getElementById('itemAddress').value = item.address || '';
        document.getElementById('itemMemo').value = item.memo || '';
      } else {
        document.getElementById('itemModalTitle').textContent = `Day ${day.dayNum} (${day.shortDate}) 일정 추가`;
        document.getElementById('itemTime').value = '10:00';
        document.getElementById('itemDuration').value = '';
        document.getElementById('itemCategory').value = 'spot';
        document.getElementById('itemPlace').value = '';
        document.getElementById('itemAddress').value = day.city !== '일정 미정' ? day.city : '';
        document.getElementById('itemMemo').value = '';
      }
      document.getElementById('itemModal').classList.add('open');
    }

    function saveTimelineItem() {
      const place = document.getElementById('itemPlace').value.trim();
      if (!place) {
        alert('장소명을 입력해주세요.');
        return;
      }
      const day = state.days[selectedDayIndex];
      const editId = document.getElementById('editItemId').value;
      const payload = {
        id: editId || 'item_' + Date.now() + '_' + Math.random().toString(36).slice(2, 6),
        time: document.getElementById('itemTime').value || '09:00',
        duration: document.getElementById('itemDuration').value.trim(),
        category: document.getElementById('itemCategory').value,
        place,
        address: document.getElementById('itemAddress').value.trim(),
        memo: document.getElementById('itemMemo').value.trim()
      };

      if (editId) {
        const idx = day.items.findIndex(x => x.id === editId);
        if (idx > -1) day.items[idx] = payload;
      } else {
        day.items.push(payload);
      }
      day.items.sort((a, b) => (a.time || '').localeCompare(b.time || ''));
      closeModal('itemModal');
      saveState();
      showToast('일정이 저장되었습니다.');
    }

    function deleteTimelineItem(itemId) {
      if (!confirm('이 일정을 삭제할까요?')) return;
      const day = state.days[selectedDayIndex];
      day.items = day.items.filter(x => x.id !== itemId);
      saveState();
      showToast('일정이 삭제되었습니다.');
    }

    // Bookings CRUD
    function renderBookings() {
      renderBookingGroup('flights', 'flightsList', '등록된 항공편이 없습니다.');
      renderBookingGroup('stays', 'staysList', '등록된 숙소 예약이 없습니다.');
      renderBookingGroup('transports', 'transportsList', '등록된 현지 기차·버스 예약이 없습니다.');
    }

    function renderBookingGroup(type, containerId, emptyMsg) {
      const container = document.getElementById(containerId);
      const list = state.bookings[type] || [];
      if (list.length === 0) {
        container.innerHTML = `<div style="color:var(--text-muted); font-size:13px; padding:10px 0;">${emptyMsg}</div>`;
        return;
      }
      container.innerHTML = list.map(bk => {
        const mapBtn = bk.location
          ? `<a class="btn-map" href="https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(bk.location)}" target="_blank" rel="noopener">📍 구글 맵 열기</a>`
          : '';
        return `
          <div class="booking-card">
            <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:8px;">
              <div class="booking-card-title">${escapeHtml(bk.title)}</div>
              ${bk.pnr ? `<span class="pnr-badge">예약번호: ${escapeHtml(bk.pnr)}</span>` : ''}
            </div>
            <div class="booking-meta">
              ${bk.provider ? `<div><strong>구분/도시:</strong> ${escapeHtml(bk.provider)}</div>` : ''}
              ${bk.date1 ? `<div><strong>시작/체크인:</strong> ${escapeHtml(bk.date1)}</div>` : ''}
              ${bk.date2 ? `<div><strong>도착/체크아웃:</strong> ${escapeHtml(bk.date2)}</div>` : ''}
              ${bk.memo ? `<div style="margin-top:6px; background:#fff; padding:7px 9px; border-radius:6px; border:1px solid var(--border); white-space:pre-wrap;">${escapeHtml(bk.memo)}</div>` : ''}
            </div>
            <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:6px; margin-top:4px;">
              <div>${mapBtn}</div>
              <div style="display:flex; gap:6px;">
                <button class="btn-outline" onclick="openBookingModal('${type}', '${bk.id}')">✏️ 수정</button>
                <button class="btn-danger" onclick="deleteBookingItem('${type}', '${bk.id}')">🗑️ 삭제</button>
              </div>
            </div>
          </div>
        `;
      }).join('');
    }

    function openBookingModal(type, editId = null) {
      document.getElementById('bookingType').value = type;
      document.getElementById('editBookingId').value = editId || '';

      const labels = {
        flights: { modal: '✈️ 항공편 예약', title: '항공 구간 (예: 인천 → 리스본)', d1: '출발 일시', d2: '도착 일시', prov: '항공사 · 편명' },
        stays: { modal: '🏨 숙소 예약', title: '숙소명', d1: '체크인 날짜/시간', d2: '체크아웃 날짜/시간', prov: '도시 · 국가' },
        transports: { modal: '🚆 현지 교통 예약', title: '이동 구간 (예: 리스본 → 포르투)', d1: '출발 일시', d2: '도착 일시', prov: '교통수단 (CP 기차, Renfe, ALSA 등)' }
      }[type];

      document.getElementById('bookingModalTitle').textContent = editId ? `${labels.modal} 수정` : `${labels.modal} 추가`;
      document.getElementById('bkTitleLabel').textContent = labels.title;
      document.getElementById('bkDate1Label').textContent = labels.d1;
      document.getElementById('bkDate2Label').textContent = labels.d2;
      document.getElementById('bkProviderLabel').textContent = labels.prov;

      if (editId) {
        const bk = state.bookings[type].find(x => x.id === editId);
        document.getElementById('bkTitle').value = bk.title || '';
        document.getElementById('bkDate1').value = bk.date1 || '';
        document.getElementById('bkDate2').value = bk.date2 || '';
        document.getElementById('bkProvider').value = bk.provider || '';
        document.getElementById('bkPnr').value = bk.pnr || '';
        document.getElementById('bkLocation').value = bk.location || '';
        document.getElementById('bkMemo').value = bk.memo || '';
      } else {
        ['bkTitle', 'bkDate1', 'bkDate2', 'bkProvider', 'bkPnr', 'bkLocation', 'bkMemo'].forEach(id => {
          document.getElementById(id).value = '';
        });
      }
      document.getElementById('bookingModal').classList.add('open');
    }

    function saveBookingItem() {
      const type = document.getElementById('bookingType').value;
      const title = document.getElementById('bkTitle').value.trim();
      if (!title) {
        alert('구간 또는 숙소명을 입력해주세요.');
        return;
      }
      const editId = document.getElementById('editBookingId').value;
      const payload = {
        id: editId || 'bk_' + Date.now() + '_' + Math.random().toString(36).slice(2, 6),
        title,
        date1: document.getElementById('bkDate1').value.trim(),
        date2: document.getElementById('bkDate2').value.trim(),
        provider: document.getElementById('bkProvider').value.trim(),
        pnr: document.getElementById('bkPnr').value.trim(),
        location: document.getElementById('bkLocation').value.trim(),
        memo: document.getElementById('bkMemo').value.trim()
      };

      if (editId) {
        const idx = state.bookings[type].findIndex(x => x.id === editId);
        if (idx > -1) state.bookings[type][idx] = payload;
      } else {
        state.bookings[type].push(payload);
      }
      closeModal('bookingModal');
      saveState();
      showToast('예약 내역이 저장되었습니다.');
    }

    function deleteBookingItem(type, id) {
      if (!confirm('이 예약 내역을 삭제할까요?')) return;
      state.bookings[type] = state.bookings[type].filter(x => x.id !== id);
      saveState();
      showToast('예약 내역이 삭제되었습니다.');
    }

    // Overview Table
    function renderOverview() {
      const tbody = document.getElementById('overviewTableBody');
      tbody.innerHTML = state.days.map((d, idx) => {
        const c = getCountryInfo(d.country);
        const items = (d.items || []).slice().sort((a, b) => (a.time || '').localeCompare(b.time || ''));
        const summary = items.length > 0
          ? items.map(it => `<strong>${escapeHtml(it.time)}</strong> ${escapeHtml(it.place)}`).join(' → ')
          : '<span style="color:#94a3b8;">세부 일정 미정</span>';
        return `
          <tr class="summary-row" onclick="jumpToDay(${idx})">
            <td style="white-space:nowrap;"><strong>Day ${d.dayNum}</strong><br/><span style="font-size:12px; color:var(--text-muted);">${d.shortDate}</span></td>
            <td style="white-space:nowrap;"><span class="country-badge ${c.cls}">${c.flag} ${escapeHtml(d.city)}</span></td>
            <td>${summary}${d.note ? `<div style="font-size:12px; color:var(--primary); margin-top:4px;">📝 ${escapeHtml(d.note)}</div>` : ''}</td>
          </tr>
        `;
      }).join('');
    }

    function jumpToDay(idx) {
      selectedDayIndex = idx;
      switchTab('timeline');
    }

    // Backup / Restore
    function openBackupModal() {
      document.getElementById('backupModal').classList.add('open');
    }

    function exportJsonFile() {
      const blob = new Blob([JSON.stringify(state, null, 2)], { type: 'application/json' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `iberia-travel-2027-backup-${new Date().toISOString().slice(0,10)}.json`;
      a.click();
      showToast('백업 파일이 다운로드되었습니다.');
    }

    function importJsonFile(event) {
      const file = event.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = e => {
        try {
          const imported = JSON.parse(e.target.result);
          if (!imported.days || !Array.isArray(imported.days)) throw new Error();
          state = imported;
          saveState();
          closeModal('backupModal');
          showToast('✅ 백업 데이터를 성공적으로 불러왔습니다.');
        } catch (err) {
          alert('올바른 여행 플래너 백업 파일(.json)이 아닙니다.');
        }
      };
      reader.readAsText(file);
    }

    function closeModal(id) {
      document.getElementById(id).classList.remove('open');
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    initApp();
  </script>
</body>
</html>
